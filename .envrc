# direnv — activate the Nix development shell defined in flake.nix.
# Requires direnv >= 2.30 (`use flake`).

# Ensure the Nix `nix-command` and `flakes` experimental features are enabled
# even if they are not set globally in nix.conf. NIX_CONFIG is honoured by
# every `nix` invocation, including the one spawned by `use flake` below.
if [ -n "${NIX_CONFIG:-}" ]; then
  export NIX_CONFIG="$NIX_CONFIG
experimental-features = nix-command flakes"
else
  export NIX_CONFIG="experimental-features = nix-command flakes"
fi

# Activate the dev shell from flake.nix.
use flake

# Reload the shell whenever the flake definition/lockfile changes.
watch_file flake.nix flake.lock
